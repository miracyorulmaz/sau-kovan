  "components": {
    "schemas": {
      "Assignment": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "unit_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Unit Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "unit_id"
        ],
        "title": "Assignment"
      },
      "AssistanceCreate": {
        "properties": {
          "walk_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Walk Id"
          },
          "reason": {
            "type": "string",
            "enum": [
              "ESCORT_REQUEST",
              "HELP_REQUEST"
            ],
            "title": "Reason",
            "default": "HELP_REQUEST"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "walk_id",
          "idempotency_key"
        ],
        "title": "AssistanceCreate"
      },
      "DemoReset": {
        "properties": {
          "student_count": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Student Count",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DemoReset"
      },
      "EdgeOverride": {
        "properties": {
          "closed": {
            "type": "boolean",
            "title": "Closed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "closed"
        ],
        "title": "EdgeOverride"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntentCreate": {
        "properties": {
          "meeting_point_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Meeting Point Id"
          },
          "destination_dorm_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Destination Dorm Id"
          },
          "earliest_at": {
            "type": "string",
            "format": "date-time",
            "title": "Earliest At"
          },
          "latest_at": {
            "type": "string",
            "format": "date-time",
            "title": "Latest At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "meeting_point_id",
          "destination_dorm_id",
          "earliest_at",
          "latest_at"
        ],
        "title": "IntentCreate"
      },
      "Login": {
        "properties": {
          "access_code": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Access Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_code"
        ],
        "title": "Login"
      },
      "Resolution": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "STUDENT_CONFIRMED",
              "CONTACT_COMPLETED",
              "DEMO_COMPLETED"
            ],
            "title": "Resolution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "resolution"
        ],
        "title": "Resolution"
      },
      "Review": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED_PILOT",
              "REJECTED",
              "REVOKED"
            ],
            "title": "Decision"
          },
          "method": {
            "type": "string",
            "const": "DEMO_TEST",
            "title": "Method",
            "default": "DEMO_TEST"
          },
          "student_eligibility_checked": {
            "type": "boolean",
            "title": "Student Eligibility Checked",
            "default": false
          },
          "women_student_eligibility_checked": {
            "type": "boolean",
            "title": "Women Student Eligibility Checked",
            "default": false
          },
          "verified_dorm_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified Dorm Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "decision"
        ],
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
