# Demo only. No real student, dorm or campus security integration.
KOVAN_DATA_DIR=.local
KOVAN_COOKIE_SECURE=false
KOVAN_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
KOVAN_ENABLE_LOCAL_DEMO_CONTROLS=true
# Separate server Routes API key and HTTP-referrer-restricted Maps JavaScript key.
KOVAN_GOOGLE_MAPS_API_KEY=
KOVAN_GOOGLE_MAPS_BROWSER_KEY=
# DEMO simulates notifications. WHATSAPP requires all provider settings below.
KOVAN_NOTIFICATION_MODE=DEMO
KOVAN_WHATSAPP_TOKEN=
KOVAN_WHATSAPP_PHONE_NUMBER_ID=
# Use the supported pinned version displayed in your Meta app dashboard, e.g. vNN.0.
KOVAN_WHATSAPP_API_VERSION=
KOVAN_WHATSAPP_TEMPLATE_NAME=
KOVAN_WHATSAPP_TEMPLATE_LANGUAGE=tr
KOVAN_WHATSAPP_APP_SECRET=
KOVAN_WHATSAPP_VERIFY_TOKEN=
